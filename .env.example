# Copy via scripts/setup-local.ps1, which generates fresh development secrets.
POSTGRES_DB=spilton
POSTGRES_USER=spilton
POSTGRES_PASSWORD=GENERATE_A_RANDOM_PASSWORD
POSTGRES_PORT=5432
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES

# Day 2. Defaults work without external credentials in ASP.NET Development only.
MODEL_DEFAULT=development
MODEL_DEVELOPMENT_ENABLED=true
MODEL_TIMEOUT_SECONDS=90
# Optional compatible HTTPS provider. Leave blank until you have valid access.
# The base URL is the API prefix, commonly ending in /v1, not /chat/completions.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_PROVIDER_LABEL=Compatible provider

# Phase 2.1 optional real web search. Store a private Tavily key only in .env.
WEB_TAVILY_API_KEY=

# Brevo HTTPS delivery is recommended on Render. Verify this exact sender in Brevo.
EMAIL_PROVIDER=Disabled
EMAIL_BREVO_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Spilton AI
EMAIL_ENABLE_SSL=true

# Use Database on Render for durable storage without an R2/S3 account. Local remains the development default.
# S3-compatible settings below are only required when STORAGE_PROVIDER=S3.
STORAGE_PROVIDER=Local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_KEY_PREFIX=documents
STORAGE_FORCE_PATH_STYLE=true

# Google OAuth. The redirect URI must be added exactly in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_FRONTEND_ORIGIN=

# Optional image generation through an OpenAI-compatible HTTPS Images API.
# The text-chat Groq key cannot generate images.
IMAGE_GENERATION_PROVIDER=Disabled
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_TIMEOUT_SECONDS=120

# Day 3 local CPU embeddings and exact pgvector retrieval.
RAG_CHUNK_TOKENS=200
RAG_OVERLAP_TOKENS=30
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.25
RAG_DIAGNOSTICS=false
