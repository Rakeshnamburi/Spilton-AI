# Copy via scripts/setup-local.ps1, which generates fresh development secrets.
POSTGRES_DB=spilton
POSTGRES_USER=spilton
POSTGRES_PASSWORD=GENERATE_A_RANDOM_PASSWORD
POSTGRES_PORT=5432
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES

# Day 2. Defaults work without external credentials in ASP.NET Development only.
MODEL_DEFAULT=development
MODEL_DEVELOPMENT_ENABLED=true
MODEL_TIMEOUT_SECONDS=90
# Optional compatible HTTPS provider. Leave blank until you have valid access.
# The base URL is the API prefix, commonly ending in /v1, not /chat/completions.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_PROVIDER_LABEL=Compatible provider

# Phase 2.1 optional real web search. Store a private Tavily key only in .env.
WEB_TAVILY_API_KEY=

# Optional SMTP delivery for password-reset one-time codes.
EMAIL_PROVIDER=Disabled
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Spilton AI
EMAIL_ENABLE_SSL=true

# Optional durable private S3-compatible document storage. Local remains the development default.
STORAGE_PROVIDER=Local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_KEY_PREFIX=documents
STORAGE_FORCE_PATH_STYLE=true

# Day 3 local CPU embeddings and exact pgvector retrieval.
RAG_CHUNK_TOKENS=200
RAG_OVERLAP_TOKENS=30
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.25
RAG_DIAGNOSTICS=false
